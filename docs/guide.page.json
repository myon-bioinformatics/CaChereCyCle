            },
            {
              "label": "📄 cacherecycle.py",
              "href": "https://github.com/myon-bioinformatics/CaChereCyCle/blob/main/cacherecycle.py"
            },
            {
              "label": "🏛 store.jsonl",
              "href": "https://github.com/myon-bioinformatics/CaChereCyCle/blob/main/store.jsonl"
            }
          ]
        }
      ]
    }
  ]
}
